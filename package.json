{
  "name": "app-rooftop-solar",
  "version": "0.1.0",
  "private": true,
  "description": "Front end for the Global Rooftop Solar Potential Calculator: map interaction, tap-based question flow, i18n, PDF report generation. Depends on engine-system-economics (which transitively depends on engine-radiation-uncertainty) as a package, bundled into one static site at build time. No backend server.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "leaflet": "^1.9.4",
    "@turf/turf": "^7.1.0",
    "engine-system-economics": "github:JuyongJuyongJuyong/engine-system-economics#v0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JuyongJuyongJuyong/app-rooftop-solar.git"
  }
}
